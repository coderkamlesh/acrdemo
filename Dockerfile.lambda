# Stage 1: Build native image with GraalVM 25
FROM ghcr.io/graalvm/native-image-community:25 AS build
WORKDIR /app

# Install Maven aur binutils (strip command ke liye)
RUN microdnf install -y tar gzip binutils && \
    curl -fsSL https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.tar.gz | tar -xz -C /opt && \
    ln -s /opt/apache-maven-3.9.9/bin/mvn /usr/local/bin/mvn && \
    microdnf clean all

# Maven memory optimization
ENV MAVEN_OPTS="-Xmx1024m -XX:+UseSerialGC"

# Dependencies caching layer
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Source copy & compile native executable
COPY src ./src
RUN mvn -Pnative native:compile -DskipTests -Dnative.buildArgs="-J-Xmx5120m --no-fallback"

# Strip debug symbols to drastically reduce binary size and memory page-faults
RUN strip /app/target/acrdemo

# Stage 2: Minimal runtime
FROM oraclelinux:9-slim
WORKDIR /app

# Lambda Web Adapter injection
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.8.4 /lambda-adapter /opt/extensions/lambda-adapter

# Web Adapter configuration for immediate port readiness detection
ENV PORT=8080
ENV AWS_LWA_PORT=8080
ENV AWS_LWA_READINESS_CHECK_PATH=/actuator/health/readiness
ENV AWS_LWA_READINESS_CHECK_MIN_BEAT=10

RUN adduser --system --uid 1001 spring
USER spring:spring

COPY --from=build /app/target/acrdemo /app/acrdemo

EXPOSE 8080
ENTRYPOINT ["/app/acrdemo", "-Djava.security.egd=file:/dev/./urandom"]